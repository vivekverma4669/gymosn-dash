# =============================================
# Fitdesk Backend Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=mongodb://localhost:27017/fitdesk

# JWT Secrets (generate strong secrets in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URL (for CORS + cookie origin)
CLIENT_URL=http://localhost:3000

# Redis (config only, not actively used yet)
REDIS_URL=redis://localhost:6379

# Seed: the one platform Super Admin account (npm run seed:superadmin)
SUPERADMIN_EMAIL=superadmin@fitdesk.com
SUPERADMIN_PASSWORD=change-me-now-12345

# Meta WhatsApp Cloud API (official, no BSP middleman). Optional: automated renewal reminders
# and birthday wishes safely no-op (logged as "skipped") until these are set.
# Get these from Meta Business Manager > WhatsApp > API Setup, after business verification and
# after your "renewal_reminder", "birthday_wish" and "manual_reminder" templates are approved.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
